# Security headers for every page Netlify serves. Vite copies this file into dist/.
# The content security policy only reports for now. Once the browser console shows
# no reports on the live site, rename the header to Content-Security-Policy and add
# frame-ancestors 'none' (browsers ignore frame-ancestors in a report-only policy,
# which is why X-Frame-Options stays). tests/e2e/securityHeaders.spec.ts loads every
# page under this policy and fails on any violation.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://formspree.io; frame-src https://maps.google.com https://www.google.com; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'
